# ============================================================================
# Build-context excludes for the backend image.
# Keeps the `COPY . .` in the builder stage lean and the build cache stable.
# Anything not listed here that the app needs at runtime (src/, fonts/,
# pdf-templates/, static/, main.py, pyproject.toml, uv.lock) is shipped.
# ============================================================================

# --- Python build/byte artifacts ---
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments (rebuilt inside the image) ---
.venv/
venv/
ENV/
env/
.ENV

# --- Testing / coverage ---
tests/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
*.cover
*.py,cover
.cache/
nosetests.xml
coverage.xml

# --- Linters / type checkers ---
.ruff_cache/
.mypy_cache/
.pyright/

# --- IDE / editor / OS ---
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~
**/.DS_Store

# --- VCS ---
.git/
.gitignore
.gitattributes

# --- Docs (README is allowed back in if ever needed) ---
*.md
!README.md
specs/
.specify/

# --- CI/CD & deploy config (not needed in the image) ---
.github/
fly.toml
Makefile

# --- Tooling config ---
.pre-commit-config.yaml
.python-version

# --- Secrets / local env (never bake into an image) ---
.env
.env.*
!.env.example

# --- Logs & temp ---
*.log
*.log.*
*.tmp
*.bak

# --- Docker (the build recipe itself doesn't belong inside the image) ---
Dockerfile*
.dockerignore
