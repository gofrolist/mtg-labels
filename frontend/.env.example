# Backend API Base URL
# Development: http://localhost:8080
# Production: Set this to your backend URL
VITE_API_BASE_URL=http://localhost:8080

# Sentry (optional) — powers error reporting and the "Feedback" button's
# delivery to Sentry's User Feedback inbox. Leave unset locally: the SDK stays
# inert and the feedback form logs to the console instead of sending.
VITE_SENTRY_DSN=
# Defaults to Vite's MODE when unset
VITE_SENTRY_ENVIRONMENT=
# Git SHA, injected at build time; empty means no release tag
VITE_SENTRY_RELEASE=
